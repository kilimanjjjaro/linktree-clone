generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  accounts      Account[]
  trees         Tree[]
}

model Account {
  id                String  @id @default(cuid())
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model ConfirmationToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires_at DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires_at DateTime

  @@unique([email, token])
}

model Tree {
  id             String              @id @default(cuid())
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String              @map("author_id")
  status         Int
  name           String
  slug           String
  url            String
  description    String
  avatar         String
  socialProfiles TreeSocialProfile[]
  links          TreeLink[]
  appearance     Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model TreeSocialProfile {
  id     String @id @default(cuid())
  type   Int
  url    String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  treeId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model TreeLink {
  id              String  @id @default(cuid())
  name            String
  url             String
  featured        Boolean
  backgroundImage String?
  Tree            Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  treeId          String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
