generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String    @default("https://res.cloudinary.com/dsvcixsbp/image/upload/c_scale,h_150/v1714920612/linktree/default-user-avatar_zujorl.jpg")
  accounts      Account[]
  trees         Tree[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model ConfirmationToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires_at DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires_at DateTime

  @@unique([email, token])
}

model Tree {
  id             String              @id @default(cuid())
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String              @map("author_id")
  status         Int
  name           String
  url            String
  description    String
  avatar         String
  socialProfiles TreeSocialProfile[]
  links          TreeLink[]
  appearance     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, url])
}

model TreeSocialProfile {
  id     String             @id @default(cuid())
  tree   Tree               @relation(fields: [treeId], references: [id], onDelete: Cascade)
  treeId String
  type   SocialProfileTypes
  url    String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([treeId, type])
}

model TreeLink {
  id       String  @id @default(cuid())
  Tree     Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  treeId   String
  name     String
  url      String
  featured Boolean
  image    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([treeId, url])
}

enum SocialProfileTypes {
  DISCORD
  EMAIL
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  PINTEREST
  REDDIT
  TELEGRAM
  THREADS
  TIKTOK
  TWITCH
  TWITTER
  WHATSAPP
  YOUTUBE
}
